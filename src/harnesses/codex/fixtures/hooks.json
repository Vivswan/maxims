{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.codex/hooks/session_notes.py",
            "statusMessage": "Loading session notes",
            "additionalContextLimit": 5000,
            "timeout": 30,
            "async": false
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.codex/hooks/guard_shell.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
