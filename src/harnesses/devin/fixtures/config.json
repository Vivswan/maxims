{
  "read_config_from": {
    "claude": true
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "exec",
        "hooks": [
          {
            "type": "command",
            "command": "./scripts/check-command.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
