{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model":   "opus",
  "theme": "dark",
  "language":"en",
  "autoUpdates": false,
  "cleanupPeriodDays": 30,
  "includeCoAuthoredBy": false,
  "verbose": true,
  "alwaysThinkingEnabled": true,
  "spinnerTipsEnabled": false,
  "showTurnDuration": true,
  "env": {
    "NO_COLOR":  "1",
    "EDITOR": "vim",
    "CLAUDE_CODE_MAX_OUTPUT_TOKENS": "32000"
  },
  "permissions": {
    "allow": [ "Bash(bun run test)", "Bash(git status)",
               "Read(~/.config/example/**)" ],
    "deny": ["Read(./.env)", "Read(./.env.*)"],
    "defaultMode": "acceptEdits",
    "additionalDirectories": ["/home/user/notes"]
  },
  "statusLine": {"type": "command", "command": "/home/user/.claude/statusline.sh", "padding": 0},
  "outputStyle": "Explanatory",
  "enabledPlugins": {
    "example-plugin@example-marketplace": true
  },
  "extraKnownMarketplaces": {
    "example-marketplace": {
      "source": { "source": "github", "repo": "example-user/example-marketplace" }
    }
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          { "type": "command",
            "command": "python3 /home/user/.claude/hooks/session-notes.py",
            "timeout": 30 }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [{ "type": "command", "command": "/home/user/.claude/hooks/guard-bash.sh" }]
      }
    ]
  },
  "companionEnabled": false,
  "respectGitignore": true,
  "attribution": { "commit": "", "pr": "" },
  "fastModeEnabled": false,
  "disableAllHooks": false
}
