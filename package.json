{
  "name": "@vivswan/maxims",
  "version": "0.0.0",
  "description": "One-line rule memories installed from GitHub repos into coding agents, guaranteed to load every session",
  "license": "SEE LICENSE IN LICENSE.md",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Vivswan/maxims.git"
  },
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "maxims": "dist/cli.js"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "check": "bun run lint && bun run typecheck && bun run test && bun run build && bun run knip && bun run docs:tables:check",
    "lint": "bun x biome ci .",
    "lint:fix": "bun x biome check --write .",
    "typecheck": "bun x tsc -p . && bun run typecheck:node-floor",
    "typecheck:node-floor": "bun x tsc -p tsconfig.node-floor.json",
    "test": "bun scripts/run_tests.ts",
    "build": "bun scripts/build.ts",
    "knip": "bun x knip",
    "bench": "bun scripts/bench.ts",
    "bench:ci": "bun scripts/bench_ci.ts",
    "nightly": "bun scripts/nightly.ts",
    "test:container": "bun scripts/container_tests.ts",
    "docs:tables": "bun scripts/render_docs_tables.ts",
    "docs:tables:check": "bun scripts/render_docs_tables.ts --check"
  },
  "devDependencies": {
    "@actions/expressions": "0.3.61",
    "@biomejs/biome": "2.5.11",
    "@clack/prompts": "1.8.1",
    "@hyperjump/json-pointer": "1.1.3",
    "@simple-git/argv-parser": "2.0.1",
    "@types/bun": "1.4.2",
    "@types/debug": "4.1.13",
    "@types/node": "24.19.2",
    "@types/semver": "7.8.0",
    "@vercel/detect-agent": "1.2.5",
    "debug": "4.4.3",
    "diff": "9.0.0",
    "fast-check": "4.10.2",
    "fast-string-width": "3.0.2",
    "fast-wrap-ansi": "0.2.2",
    "jsonc-parser": "3.3.1",
    "knip": "6.35.1",
    "leven": "4.1.0",
    "mdast-util-from-markdown": "2.1.0",
    "micromark": "4.0.2",
    "micromark-util-subtokenize": "2.1.0",
    "micromark-util-types": "2.0.2",
    "oxc-parser": "0.148.0",
    "picocolors": "1.1.1",
    "pretty-bytes": "7.2.0",
    "semver": "7.8.5",
    "signal-exit": "4.1.0",
    "simple-git": "4.0.2",
    "smol-toml": "1.9.0",
    "tar": "7.5.22",
    "typescript": "7.0.2",
    "unist-util-visit": "5.1.0",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  }
}
