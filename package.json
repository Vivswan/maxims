{
  "name": "@vivswan/maxims",
  "version": "0.0.0",
  "description": "One-line rule memories installed from GitHub repos into coding agents, guaranteed to load every session",
  "license": "SEE LICENSE IN LICENSE.md",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Vivswan/maxims.git"
  },
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "maxims": "dist/cli.js"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "check": "bun run lint && bun run typecheck && bun run test && bun run build && bun run knip",
    "lint": "bun x biome ci .",
    "lint:fix": "bun x biome check --write .",
    "typecheck": "bun x tsc -p .",
    "test": "bun scripts/run_tests.ts",
    "build": "bun scripts/build.ts",
    "knip": "bun x knip",
    "bench": "bun scripts/bench.ts",
    "nightly": "bun scripts/nightly.ts",
    "test:container": "bun scripts/container_tests.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@types/bun": "1.4.2",
    "@types/picomatch": "4.0.3",
    "@types/semver": "7.8.0",
    "knip": "6.35.1",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@clack/prompts": "1.8.1",
    "@vercel/detect-agent": "1.2.5",
    "jsonc-parser": "3.3.1",
    "picocolors": "1.1.1",
    "picomatch": "4.0.7",
    "semver": "7.8.5",
    "simple-git": "3.36.0",
    "smol-toml": "1.8.0",
    "tar": "7.5.22",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  }
}
