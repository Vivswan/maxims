{
  "name": "@vivswan/maxims",
  "version": "0.0.0",
  "description": "One-line rule memories installed from GitHub repos into coding agents, guaranteed to load every session",
  "license": "SEE LICENSE IN LICENSE.md",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Vivswan/maxims.git"
  },
  "engines": {
    "node": ">=20.5"
  },
  "bin": {
    "maxims": "dist/cli.js"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "check": "bun run lint && bun run typecheck && bun run test && bun run build && bun run knip && bun run docs:check && bun run docs:matrix:check && bun run lint:arch && bun run test:arch && bun run docs:arch:check",
    "lint": "bun x biome ci .",
    "lint:fix": "bun x biome check --write .",
    "typecheck": "bun x tsc -p .",
    "test": "bun scripts/run_tests.ts",
    "build": "bun scripts/build.ts",
    "knip": "bun x knip",
    "bench": "bun scripts/bench.ts",
    "bench:ci": "bun scripts/bench_ci.ts",
    "nightly": "bun scripts/nightly.ts",
    "test:container": "bun scripts/container_tests.ts",
    "docs:check": "bun scripts/docs_probe.mts --max-cell-words 15 README.md AGENTS.md docs/*.md",
    "docs:matrix": "bun scripts/render_harness_matrix.ts",
    "docs:matrix:check": "bun scripts/render_harness_matrix.ts --check",
    "lint:arch": "bun scripts/arch_lint.mts --root .",
    "docs:arch": "bun scripts/render_architecture_map.mts --page docs/architecture.md",
    "docs:arch:check": "bun scripts/render_architecture_map.mts --page docs/architecture.md --check",
    "test:arch": "bun scripts/check_architecture_page.mts --page docs/architecture.md --repo-url https://github.com/Vivswan/maxims/blob/main/ --expect-diagrams 14"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@clack/prompts": "1.8.1",
    "@types/bun": "1.4.2",
    "@types/debug": "4.1.13",
    "@types/picomatch": "4.0.3",
    "@types/semver": "7.8.0",
    "@vercel/detect-agent": "1.2.5",
    "debug": "4.4.3",
    "decode-named-character-reference": "1.3.0",
    "diff": "9.0.0",
    "jsonc-parser": "3.3.1",
    "knip": "6.35.1",
    "micromark": "4.0.2",
    "micromark-extension-gfm-strikethrough": "2.1.0",
    "micromark-extension-gfm-table": "2.1.2",
    "micromark-extension-gfm-task-list-item": "2.1.0",
    "micromark-util-decode-numeric-character-reference": "2.0.2",
    "micromark-util-normalize-identifier": "2.0.1",
    "micromark-util-subtokenize": "2.1.0",
    "micromark-util-types": "2.0.2",
    "node-html-parser": "9.0.4",
    "oxc-parser": "0.148.0",
    "picocolors": "1.1.1",
    "picomatch": "4.0.7",
    "semver": "7.8.5",
    "signal-exit": "4.1.0",
    "simple-git": "3.36.0",
    "smol-toml": "1.8.0",
    "tar": "7.5.22",
    "typescript": "7.0.2",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  }
}
